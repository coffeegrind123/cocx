+// xpgpAutocryptHeader builds an `Autocrypt:` header value from client-supplied base64
+// key material, or returns "" when there is nothing usable to send.
+//
+// ⚠ THE CHARSET CHECK IS THE SECURITY CONTROL, not a tidiness check. The only thing
+// standing between a browser and an injected header is that CR and LF cannot survive
+// this loop: the value is rebuilt from a strict base64 alphabet, so a newline (or a
+// second header, or a Bcc) cannot be smuggled through. Never relax it to "trim and
+// hope" — mox writes headers with a bare Fprintf and does no escaping of its own.
+//
+// ⚠ IT MUST BE FOLDED. message.Composer.Header is `fmt.Fprintf("%s: %s\r\n")` with no
+// folding whatsoever, and a real key is several KB of base64 — far past RFC 5322's
+// 998-octet line limit. An over-long header line is not a clean failure: it is mail that
+// some servers refuse and some parsers silently mangle. Continuation lines begin with a
+// space, which is what every Autocrypt parser (including our own parseAutocrypt) unfolds.
+//
+// Anything wrong here yields "" and therefore NO header — an ordinary, perfectly valid
+// message. Opportunistic key distribution must never be able to break a send.
+// Added by the cocx OpenPGP patch series.
+func xpgpAutocryptHeader(keydata string, from smtp.Address) string {
+	const maxSize = 64 * 1024
+	if keydata == "" || len(keydata) > maxSize {
+		return ""
+	}
+	for i := 0; i < len(keydata); i++ {
+		c := keydata[i]
+		ok := c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '+' || c == '/' || c == '='
+		if !ok {
+			return ""
+		}
+	}
+	// prefer-encrypt=nopreference, deliberately, not "mutual". Mutual tells peers to
+	// encrypt BY DEFAULT, which is a promise we cannot keep while the private key lives
+	// only in one browser: the admin mailbox reads over IMAP and would be handed
+	// ciphertext it cannot open. Revisit when the key is somewhere the server can use.
+	var b strings.Builder
+	b.WriteString("addr=")
+	b.WriteString(from.Pack(true))
+	b.WriteString("; prefer-encrypt=nopreference; keydata=")
+	const width = 72
+	for i := 0; i < len(keydata); i += width {
+		j := i + width
+		if j > len(keydata) {
+			j = len(keydata)
+		}
+		if i > 0 {
+			b.WriteString("\r\n ")
+		}
+		b.WriteString(keydata[i:j])
+	}
+	return b.String()
+}
