+// xpgpArmor validates a client-supplied ASCII-armored OpenPGP message and returns it
+// with CRLF line endings, ready to be written as a MIME part body.
+//
+// Everything about this is defensive. The value crosses from a browser into a message
+// this server will sign with our DKIM key and send under our domain's reputation, so it
+// is checked rather than trusted:
+//   - it must actually be an OpenPGP armored MESSAGE, not a key block, not a signature,
+//     and not arbitrary text. A recipient whose client sees multipart/encrypted and then
+//     cannot find a message inside gets a broken mail from us.
+//   - it must be pure 7-bit ASCII apart from line endings. Armor is base64 plus header
+//     lines and can be nothing else; anything outside that range means the client sent
+//     something other than what it claimed.
+//   - line endings are normalised to CRLF, because a bare LF inside a MIME part is
+//     tolerated by most parsers and rejected by strict ones, and the client is a browser
+//     where "\n" is the natural thing to produce.
+// Added by the cocx OpenPGP patch series.
+func xpgpArmor(ctx context.Context, s string) []byte {
+	const maxSize = 100 * 1024 * 1024
+	if len(s) > maxSize {
+		xcheckuserf(ctx, errors.New("too large"), "checking pgp message")
+	}
+	s = strings.ReplaceAll(s, "\r\n", "\n")
+	s = strings.TrimSpace(s)
+	if !strings.HasPrefix(s, "-----BEGIN PGP MESSAGE-----") || !strings.HasSuffix(s, "-----END PGP MESSAGE-----") {
+		xcheckuserf(ctx, errors.New("not an ascii-armored openpgp message"), "checking pgp message")
+	}
+	for _, c := range []byte(s) {
+		if c == '\n' {
+			continue
+		}
+		if c < 0x20 || c > 0x7e {
+			xcheckuserf(ctx, errors.New("armor contains non-ascii or control characters"), "checking pgp message")
+		}
+	}
+	return []byte(strings.ReplaceAll(s, "\n", "\r\n") + "\r\n")
+}
